# GHOSTSENTINEL Ω — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ── LAN Access (disabled by default) ─────────────────────────────────────────
# Set to true ONLY on a trusted local network with a firewall.
# If true, you MUST also configure strong authentication.
ALLOW_LAN_ACCESS=false

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in the project root. Use an absolute path for production.
# DATABASE_URL=sqlite:///./ghostsentinel.db

# ── Scan Limits ───────────────────────────────────────────────────────────────
SCAN_TIMEOUT_SECONDS=60
DEVICE_SCAN_RATE_LIMIT=0.1

# ── Reports ───────────────────────────────────────────────────────────────────
# REPORTS_DIR=/path/to/custom/reports/output
